module(
    name = "eigen",
    version = "3.3.swiftnav.1",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "0.0.9")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_swiftnav", version = "0.1.0")

# MKL's GNU threading layer (libmkl_gnu_thread.a) needs a GNU-ABI OpenMP
# runtime. The hermetic, sysroot-less LLVM toolchain ships no system libgomp,
# so depend on its own libomp (which implements the GOMP_* symbols) explicitly
# instead of relying on `-l:libgomp.a` resolving against a sysroot search path.
bazel_dep(name = "llvm", version = "0.8.6")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm, "llvm-project")

# Use repo extension to provide MKL dependencies via http_archive
mkl_ext = use_extension("//extensions:mkl_extension.bzl", "mkl_extension")
use_repo(mkl_ext, "mkl", "mkl_headers")
